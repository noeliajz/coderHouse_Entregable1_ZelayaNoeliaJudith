<h1>Todos los productos se actualizan en tiempo real !</h1>

<h2>Productos Actualizados</h2>

<div id="productsList">

{{#each pagination.docs}}
  <h3>Título: {{this.title}}</h3>
  <h4>Descripción:{{this.description}}</h4>
  <p>Código: {{this.code}}</p>
  <p>Precio: ${{this.price}}</p>

  {{#each this.thumbnails}}
    <img src="{{this}}" width="180"/>
  {{/each}}

{{/each}}

</div>

<a href="/realtimeproducts?page={{pagination.prevPage}}">{{pagination.prevPage}}</a>
<a href="/realtimeproducts?page={{pagination.nextPage}}">{{pagination.nextPage}}</a>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

socket.on("products", (products) => {

     console.log("Estos son los productos", products);
    const container = document.getElementById("productsList");

    container.innerHTML = "";

    products.forEach(product => {

        container.innerHTML += `
            <h3>${product.title}</h3>
            <h4>${product.description}</h4>
            <p>${product.code}</p>
            <p>${product.price}</p>
        `;

    });
 
});

</script>