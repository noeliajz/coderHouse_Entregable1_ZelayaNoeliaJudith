<h1>Página Principal (index.handlebars)</h1>

<h2>Filtrar por precio</h2>

<form method="GET" action="/">
  <label>Ingresar categoría:</label>
  <input type="String" name="maxPrice" placeholder="">
  <button type="submit">Buscar</button>
</form>

<h1>Nuestros Productos</h1>

{{#each pagination.docs}}
  <h2>Título: {{this.title}}</h2>
  <p>Descripción: {{this.description}}</p>
  <p>Código: {{this.code}}</p>
  <p>Precio: ${{this.price}}</p>
  <p>Categoría: {{this.category}}</p>
  <p>Stock: {{this.stock}}</p>
  {{#each this.thumbnails}}
    <img src="{{this}}" width="200"/>
  {{/each}}
  
  <a href="/product/{{this._id}}">Ver más</a>
{{/each}}

<br>
<a href="/?page={{pagination.prevPage}}">{{pagination.prevPage}}</a>
<a href="/?page={{pagination.nextPage}}">{{pagination.nextPage}}</a>