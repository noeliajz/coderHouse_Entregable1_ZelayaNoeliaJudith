<h1>Todos los productos</h1>

{{#each pagination.docs}}
  <h3>{{this.title}}</h3>
  <h4>{{this.description}}</h4>
  <p>{{this.code}}</p>
  <p>{{this.price}}</p>
  {{#each this.thumbnails}} <img src="{{this}}" /> {{/each}}

{{/each}}

<a href="/tienda?page={{pagination.prevPage}}">{{pagination.prevPage}}</a>
<a href="/tienda?page={{pagination.nextPage}}">{{pagination.nextPage}}</a>
